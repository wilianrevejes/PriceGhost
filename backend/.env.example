# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/priceghost

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
PORT=3001
NODE_ENV=development

# --- Headless browser (scraping) -------------------------------------------
# Chrome/Chromium binary. Leave unset to use the one Puppeteer downloads.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Persistent, logged-in browser profile. REQUIRED for Amazon .com.br and
# Mercado Livre: both answer a clean stealth profile with a bot wall (Amazon
# returns HTTP 200 with a block page, so no status-code fallback catches it).
# One Chrome per profile directory — the scraper will not launch while another
# Chrome is using it. See docs/LOJAS-BR.md.
# PUPPETEER_USER_DATA_DIR=/home/wradmin/.config/chromium-wsl

# --- price-tracker import ---------------------------------------------------
# Source checkout for scripts/import-price-tracker.ts (read-only).
# PRICE_TRACKER_DIR=/home/wradmin/dev/price-tracker

# --- scheduler --------------------------------------------------------------
# Default check interval is 24h per product (refresh_interval = 86400), and the
# cron tick every minute only scrapes what is already due.
# Boot the API without the scheduler — do this while migrating or right after
# an import, so the catalogue is not scraped before you want it to be.
# DISABLE_SCHEDULER=true

# --- driving a browser that is already running -------------------------------
# One Chrome per profile directory: if a Chrome is already open on
# PUPPETEER_USER_DATA_DIR, launching another aborts ("Failed to create
# SingletonLock"). Point this at the running browser's debugging endpoint and
# the scraper drives that one instead, same session, no conflict.
# On this machine: chrome-wsl --cdp exposes 127.0.0.1:9222.
# PUPPETEER_CDP_URL=http://127.0.0.1:9222
